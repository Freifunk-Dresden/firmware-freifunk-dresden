 "targets": [
# ------------- templates (default values) ------------------------------
  {
    # templates are the default config for a config object below.
    # when 'type' is set to 'template', the 'name' is the template name.
    # if 'type' is not present or value is set to 'target', then
    # the object is a target configuration. It must have set
    # 'template' json value to select the default or it should specify the complete configuration.
    "type":"template",        # specifes that this object is a template for other targets or not.
                              # values: "template | target"
                              # default for "type" is "target"
    "name":"22.03",           # [template|target ]template or target name

    "template":"",            # [target]          name of the template configuration
    "config":"",              # [target]          config file name
    "disabled": false,        # [template|target] if type is "template" then all targets are disabled, unless one target overwrites it
                              # values: "true | false"
    "openwrt_rev":"v22.03.7", # [template|target]
    "openwrt_variant":"",     # [template|target] creates a separate buildroot. use it for low-mem devices
                              #                   where no kernel modules (e.g.: usb) must be included.
                              #                   Note that selecting some packages as module could have
                              #                   dependencies to kernel modules/libs, that are included
                              #                   in image also if package is optional (ipk)
                              #                   This value is added to config file name

    "selector-config" :"22.03",  # [template|target] used to select config
    "selector-feeds"  :"22.03",  # [template|target] used to select feeds
    "selector-patches":"22.03",  # [template|target] used to select patches
    "selector-files"  :"22.03",  # [template|target] used to select files

    # [template|target] generates the feeds/feeds-[selector].conf
    # for short commit value use: git log --abbrev-commit
    "feeds" : [
      { "type":"src-link", "name":"ddmesh",   "src":"" },
      { "type":"src-git",  "name":"packages", "src":"https://git.openwrt.org/feed/packages.git", "rev":"3b79b05673a1" },
      { "type":"src-git",  "name":"routing",  "src":"https://git.openwrt.org/feed/routing.git",  "rev":"1ff9ee61cde0" }
    ],

    # [template|target] install addional packages from feeds (see feeds.conf)
    "packages" : [
      "liblzma", "libpam", "libnetsnmp", "libusbmuxd", "libimobiledevice", "usbmuxd", "usbutils", "htop", "tmux"
    ]
  },
