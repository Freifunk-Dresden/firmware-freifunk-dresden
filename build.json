# - config/targets have all:
#  - >= 16Mbyte Flash
#  - >= 64Mbyte RAM
#- all configs for devices less than those values are "small"
#
#  Does devices will have:
#   - usb
#   - tether
#   - tcpdump
#   + wireguard

# determination of feed revisions:
# 1. checkout openwrt tag
# 2. check feeds.conf.default for revisions used
#

{
 "targets": [
# ------------- templates (default values) ------------------------------
  {
    # templates are the default config for a config object below.
    # when 'type' is set to 'template', the 'name' is the template name.
    # if 'type' is not present or value is set to 'target', then
    # the object is a target configuration. It must have set
    # 'template' json value to select the default or it should specify the complete configuration.
    "type":"template",        # specifes that this object is a template for other targets or not.
                              # values: "template | target"
                              # default for "type" is "target"
    "name":"22.03.6",         # template or target name

    "template":"",            # name of the default template configuration
    "config":"",              # config file name
    "disabled": false,        # if type is "template" then all targets are disabled, unless one target overwrites it
                              # values: "true | false"
    "openwrt_rev":"v22.03.6",
    "openwrt_variant":"",     # creates a separate buildroot. use it for low-mem devices
                              # where no kernel modules (e.g.: usb) must be included.
                              # Note that selecting some packages as module could have
                              # dependencies to kernel modules/libs, that are included
                              # in image also if package is optional (ipk)
                          # This value is added to config file name

    "selector-config" :"22.03",  # used to select config
    "selector-feeds"  :"22.03",  # used to select feeds
    "selector-patches":"22.03",  # used to select patches
    "selector-files"  :"22.03",

    # generates the feeds/feeds-[selector].conf
    # for short commit value use: git log --abbrev-commit
    "feeds" : [
      { "type":"src-link", "name":"ddmesh",   "src":"" },
      { "type":"src-git",  "name":"packages", "src":"https://git.openwrt.org/feed/packages.git", "rev":"e34369a41b522" },
      { "type":"src-git",  "name":"routing",  "src":"https://git.openwrt.org/feed/routing.git",  "rev":"777c115b0a633" }
    ],

    # install addional packages from feeds (see feeds.conf)
    "packages" : [
      "liblzma", "libpam", "libnetsnmp", "libusbmuxd", "libimobiledevice", "usbmuxd", "usbutils", "htop", "tmux"
    ]
  },
  {
    "type":"template",
    "name":"23.05.3",
    "openwrt_rev":"v23.05.3",
    "openwrt_variant":"",
    "selector-config":"23.05.3",
    "selector-feeds":"23.05.3",
    "selector-patches":"23.05.3",
    "selector-files":"23.05.3",
    "feeds" : [
