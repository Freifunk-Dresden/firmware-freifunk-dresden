{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build freifunk firmware",
            "type": "shell",
            "command": "./build.sh ${input:pickTarget}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always"
            }
        },
        {
            "label": "upload current file",
            "type": "shell",
            "command": "eval scp ${file} root@${input:targetIp}:/$(echo '${relativeFile}' | sed 's#fw-files/[^/]*/##' )",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always"
            }
        }
    ],
    "inputs" : [
        {
            "id" : "targetIp",
            "description" : "IP address of target",
            "default" : "192.168.222.1",
            "type" : "promptString",
        },
        {
            "id" : "pickTarget",
            "description" : "provides a list with targets",
            "default" : "list",
            "type" : "pickString",
            "options" : [
"list",
"all",
"failed",
"ath79.22.generic.gl-mifi",
"ath79.22.nand",
"ath79.22.nand.gl-e750",
"ath79.22.small.smallbuffers",
"ath79.24.generic",
"eol.ar71xx.18.generic",
"eol.ar71xx.18.tiny",
"eol.ath79.22.generic",
"eol.ath79.22.small",
"eol.ramips.18.rt305x.tiny",
"ipq40xx.22.generic",
"ipq40xx.22.generic.fritz",
"lantiq-xrx200.22.generic",
"lantiq-xrx200.22.small",
"lantiq-xway.22.generic",
"lantiq-xway.22.small",
"mediatek.22.mt7622.generic",
"mediatek.24.filogic",
"mpc85xx.22.p1010",
"mpc85xx.22.p1020",
"ramips.22.mt7620.generic",
"ramips.22.mt7620.small.usb",
"ramips.22.mt7621.offloader",
"ramips.22.mt7621.small",
"ramips.22.mt76x8.generic",
"ramips.22.mt76x8.small",
"ramips.24.mt7621.generic",
"sunxi.22.cortexa7.offloader",
"x86-64.offloader"
    ]
        }
    ]
}
