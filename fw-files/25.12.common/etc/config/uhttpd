config uhttpd main
	list listen_http        '0.0.0.0:80'
	list listen_https       '0.0.0.0:443'
	# no redirect to https, to allow access to sysinfo.json with private certs
	option redirect_https   '0'
	option home             '/www'
	option rfc1918_filter   '1'
	option max_requests	'10'
	option max_connections	'10'
	option http_keepalive   '10'
	option script_timeout   '300'
	option network_timeout  '300'
	option cert             '/etc/uhttpd.crt'
	option key              '/etc/uhttpd.key'
	list interpreter        '.cgi=/bin/sh'
	list interpreter        '.json=/bin/sh'
	option realm            'Freifunk Dresden'
	option index_page       'index.cgi'
	option error_page       '/index.cgi'

# Certificate defaults for px5g key generator
# HINT: Keep bits 1024
config cert px5g
	option days             '7300'
	option bits             '1024'
	option country          'DE'
	option state            'Saxony'
	option location         'Dresden'
	option commonname       'node.ffdd'
	option organization     'Freifunk Dresden Communities'
	option org_unit         'Freifunk Dresden'
