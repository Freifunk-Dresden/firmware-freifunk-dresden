config defaults
  # enable include netfilter extensions /usr/share/nftables.d/...
  option auto_includes '1'
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
#	option custom_chains '1'
#	option disable_ipv6 '1'

config zone 'zone_lan'
	option name 'lan'
	list network 'lan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	# ddmesh-firewall-addons.sh needs this to get 'srcnat_lan'. masquerade rule will be deleted
	option masq '1'
	option mtu_fix '1'
	option counter '1'
	# no subnet to allow dhcp

config zone 'zone_wan'
	option name 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	list network 'wan'
	list network 'wwan_helper'
	list network 'twan'
	list network 'cwan'
	option counter '1'

config zone 'zone_wifi2'
	option name 'wifi2'
	list network 'wifi2'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	# ddmesh-firewall-addons.sh needs this to get 'srcnat_wifi2'. masquerade rule will be deleted
	option masq '1'
	option mtu_fix '1'
	option counter '1'
	# no subnet to allow dhcp

#interface is NOT brought up by network system, because it is created NOT by openwrt network environment.
config zone 'zone_ffgw'
	option name 'ffgw'
	list network 'ffgw'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	option counter '1'

#interface is not brought up by network system, because it is created not by openwrt network environment.
#created by wireguard.
config zone 'zone_tbbwg'
	option name 'tbbwg'
	list network 'tbbwg'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '0'
	option mtu_fix '1'
	option subnet '10.203.0.0/16'
	option counter '1'

config zone 'zone_mesh'
	option name 'mesh'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	# ddmesh-firewall-addons.sh needs this to get chain 'srcnat_mesh' created. masquerade rule will be deleted
	option masq '1'
	# prevent openwrt to add a rule that drops illegal connection status. It would prevent forwarding
	# packet answers from internet
	option masq_allow_invalid '1'
	option mtu_fix '1'
	option counter '1'
	list network 'mesh_lan'
	list network 'mesh_wan'
	list network 'mesh_vlan'
	list network 'tbb_fastd'
	list network 'tbb_wg'
	list network 'wifi_mesh2g'
	list network 'wifi_mesh5g'

#interface is not brought up by network system, because it is created not by openwrt network environment.
#created by vpn tunnel tools
#mask: any->vpn
config zone 'zone_vpn'
	option name 'vpn'
	list network 'vpn'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	option counter '1'

