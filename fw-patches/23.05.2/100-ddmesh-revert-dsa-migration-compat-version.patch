+#  lantiq/image/vr9.mk.mk
+#  lantiq/image/tp-link.mk
+	avm,fritz3370-rev2-hynix|\
+	avm,fritz3370-rev2-micron|\
+	avm,fritz7360sl|\
+	avm,fritz7360-v2|\
+	avm,fritz7362sl|\
+	avm,fritz7412|\
+	avm,fritz7430|\
+	tplink,tdw8970)
+		;;
 	*)
 		ucidef_set_compat_version "1.1"
 		;;
