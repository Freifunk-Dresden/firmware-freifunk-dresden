diff -Naur --suppress-blank-empty --strip-trailing-cr openwrt24/include/image-commands.mk openwrt24.patch/include/image-commands.mk
--- openwrt24/include/image-commands.mk	2025-04-08 19:30:02.282228748 +0200
+++ openwrt24.patch/include/image-commands.mk	2025-04-08 20:54:13.852404271 +0200
@@ -255,6 +255,7 @@
 define Build/check-size
 	@imagesize="$$(stat -c%s $@)"; \
 	limitsize="$$(($(call exp_units,$(if $(1),$(1),$(IMAGE_SIZE)))))"; \
+	$(call INFO_MESSAGE,    INFO: Image size: $$imagesize max:$$limitsize - $$(basename $@)); \
 	[ $$limitsize -ge $$imagesize ] || { \
 		$(call ERROR_MESSAGE,    WARNING: Image file $@ is too big: $$imagesize > $$limitsize); \
 		rm -f $@; \
