+ 		err = 0;
+ 	} else {
+ 		if (fail_avg > LINK_FAIL_THRESH)
+ 			return MAX_METRIC;
+ 
+ 		rate = ewma_mesh_tx_rate_avg_read(&sta->mesh->tx_rate_avg);
