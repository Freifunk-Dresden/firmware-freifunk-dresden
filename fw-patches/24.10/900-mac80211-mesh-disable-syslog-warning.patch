+diff -rN -U10 --no-dereference backports-6.12.6.orig/net/mac80211/mesh_hwmp.c backports-6.12.6/net/mac80211/mesh_hwmp.c
+--- backports-6.12.6.orig/net/mac80211/mesh_hwmp.c	2024-12-26 17:16:47.000000000 +0100
++++ backports-6.12.6/net/mac80211/mesh_hwmp.c	2025-12-19 22:02:20.675751000 +0100
