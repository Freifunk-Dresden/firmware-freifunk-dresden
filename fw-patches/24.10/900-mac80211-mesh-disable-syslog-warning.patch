diff -rN -U10 --no-dereference openwrt.orig/package/kernel/mac80211/patches/build/900-mac80211-mesh-disable-syslog-warning.patch openwrt/package/kernel/mac80211/patches/build/900-mac80211-mesh-disable-syslog-warning.patch
