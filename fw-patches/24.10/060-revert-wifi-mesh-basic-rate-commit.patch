diff -Naur --suppress-blank-empty --strip-trailing-cr package.ori/network/config/wifi-scripts/files/usr/share/hostap/wdev.uc package/network/config/wifi-scripts/files/usr/share/hostap/wdev.uc
--- a/package/network/config/wifi-scripts/files/usr/share/hostap/wdev.uc	2025-07-08 00:05:00.675145972 +0200
+++ b/package/network/config/wifi-scripts/files/usr/share/hostap/wdev.uc	2025-07-08 00:12:57.928915003 +0200
@@ -45,7 +45,17 @@
 		system(cmd);
 	} else if (wdev.mode == "mesh") {
 		let cmd = [ "iw", "dev", ifname, "mesh", "join", wdev.ssid, "freq", wdev.freq, htmode ];
-		for (let key in [ "basic-rates", "mcast-rate", "beacon-interval" ])
+    //freifunk dresden:
+    // revert commit 'mac80211: set basic-rate for mesh interfaces'
+    // This commit breaks compatibility for 2.4Ghz Mesh network. there is no way to
+    // configure wifi on new routers with openwrt ref later than this commit. Any combination
+    // of basic-rates in /etc/config/wireless failes to join mesh network.
+    // when no basic-rates is specified, then default rates will be applied.
+    // (basic-rates 6,12,24)
+    // only solution is to avoid specifiying any basic-rate. Older openwrt wireless configuration
+    // documentation tell that basic-rate only applies to ap and adhoc.
+		// for (let key in [ "basic-rates", "mcast-rate", "beacon-interval" ])
+    for (let key in [ "mcast-rate", "beacon-interval" ])
 			if (wdev[key])
 				push(cmd, key, wdev[key]);
 		system(cmd);
