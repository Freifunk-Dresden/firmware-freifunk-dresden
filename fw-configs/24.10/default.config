
# --- build env
# https://alibabatech.medium.com/gcc-vs-clang-llvm-an-in-depth-comparison-of-c-c-compilers-899ede2be378
CONFIG_USE_LLVM_BUILD=y
CONFIG_BPF_TOOLCHAIN_BUILD_LLVM=y

# enable "Advanced configuration options (for developers)" options
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# remove opkg package infos from image
CONFIG_CLEAN_IPKG=y

# This option changes several defaults to be more suitable for
# automatic builds. This includes the following changes:
# - Deleting build directories after compiling (to save space)
# - Enabling per-device rootfs support
# BUT: I want to control our own build environment.
# CONFIG_BUILDBOT is not set

# create profiles.json for all build targets in target directory
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y

# remove full host path and only keep relative. see help
# I don't want to show path from build hosts in firmare
CONFIG_REPRODUCIBLE_DEBUG_INFO=y


# --- general target options
CONFIG_FEED_ddmesh_own=y
CONFIG_FEED_packages=y
CONFIG_FEED_routing=y
CONFIG_IMAGEOPT=y
CONFIG_PER_FEED_REPO=y


# -- per device rootfs MUST BE SET BEFORE selecting it in menuconfig
#    else this option is not applied, as all packages are already added via '*'
#    instead of 'M'. See comment on this option in menuconfig menu
# BUT: for some devices modules gets selected (PPP, wpad-basic-wolfssl,...)
# So I CAN NOT add this here !!!!
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# Select all target specific packages by default. (hope that all needed stuff is then included
# in firmware) It works together with CONFIG_TARGET_PER_DEVICE_ROOTFS 
CONFIG_ALL_NONSHARED=y


# this would create a warning when overwriting later via menuconfig. I don't know why,
# because this value will not change. so user who creates a new config must set it manually
# when more than one target should be built.
# CONFIG_TARGET_MULTI_PROFILE=y

# target image configs
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_ROOTFS_TARGZ=y

CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.222.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.222.255"

CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="Freifunk Dresden"
#CONFIG_VERSION_NUMBER=""
#CONFIG_VERSION_CODE=""
#CONFIG_VERSION_REPO="https://downloads.freifunk-dresden.de/"
CONFIG_VERSION_HOME_URL="https://freifunk-dresden.de/"
CONFIG_VERSION_MANUFACTURER="Freifunk Dresden"
CONFIG_VERSION_MANUFACTURER_URL="https://freifunk-dresden.de"
#CONFIG_VERSION_BUG_URL=""
#CONFIG_VERSION_SUPPORT_URL=""
CONFIG_VERSION_PRODUCT="Freifunk Dresden Firmware"
CONFIG_VERSION_HWREV="not used"

# dont add version to filename, because gen-upload.sh uses the filenames to
# check for duplicates
# testing: evt sollte das bei wrt22 und 18 doch enabled werden und 
# gen-upload an der stelle die version ignorieren. so könnte ich 
# unterschiedliche freifunk versionen machen, die dann über die openwrt version besser
# aussagekräftig sind in hotspot liste. und ich muss die versionen nicht
# hochzählen, wenn ich die firmware nicht höher bekomme
CONFIG_VERSION_FILENAMES=y

# no revision in file names
# CONFIG_VERSION_CODE_FILENAMES is not set

# ------- kernel --------------
# helps during developments (e.g. LTE sticks)
CONFIG_KERNEL_DEBUG_FS=y
# IMPORTANT: else ubnt-edge router will crash
CONFIG_KERNEL_SECCOMP=y
# CONFIG_KERNEL_KALLSYMS is not set

###CONFIG_KERNEL_AIO=y
###CONFIG_KERNEL_FHANDLE=y
###CONFIG_KERNEL_FANOTIFY=y
###CONFIG_KERNEL_SWAP=y

# busybox

# ------- busybox --------------
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TIMEOUT=y

# important for password
CONFIG_BUSYBOX_CONFIG_CHPASSWD=y
CONFIG_BUSYBOX_CONFIG_FEATURE_PASSWD_WEAK_CHECK=y
CONFIG_BUSYBOX_CONFIG_BASE64=y

CONFIG_BUSYBOX_CONFIG_PSTREE=y

# ------- ath stuff -------------
CONFIG_ATH_USER_REGD=y
# CONFIG_PACKAGE_ATH_DEBUG is not set
CONFIG_PACKAGE_ATH_DFS=y
CONFIG_PACKAGE_ATH_DYNACK=y

# ------- disable ppp -----------
# CONFIG_PACKAGE_kmod-ppp is not set
# CONFIG_PACKAGE_ppp is not set

# ------- disable wolfssl -------
# CONFIG_PACKAGE_libustream-wolfssl is not set
# CONFIG_PACKAGE_libwolfssl is not set
# CONFIG_WPA_WOLFSSL is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set

# ------- disable dsl (lantiq)-----
# CONFIG_PACKAGE_ltq-adsl-app is not set
# CONFIG_PACKAGE_ltq-dsl-base is not set
# CONFIG_PACKAGE_kmod-ltq-adsl-ar9 is not set
# CONFIG_PACKAGE_kmod-ltq-adsl-ar9-fw-b is not set
# CONFIG_PACKAGE_kmod-ltq-adsl-ar9-mei is not set
# CONFIG_PACKAGE_kmod-ltq-adsl-danube is not set
# CONFIG_PACKAGE_kmod-ltq-adsl-danube-fw-b is not set
# CONFIG_PACKAGE_kmod-ltq-adsl-danube-mei is not set
# CONFIG_PACKAGE_kmod-ltq-atm-ar9 is not set
# CONFIG_PACKAGE_kmod-ltq-atm-danube is not set
# CONFIG_PACKAGE_ltq-dsl-base is not set
# CONFIG_PACKAGE_ltq-vdsl-app is not set
# CONFIG_PACKAGE_dsl-vrx200-firmware-xdsl-a is not set
# CONFIG_PACKAGE_dsl-vrx200-firmware-xdsl-b-patch is not set
# CONFIG_PACKAGE_kmod-ltq-vdsl-vr9 is not set
# CONFIG_PACKAGE_kmod-ltq-vdsl-vr9-mei is not set
# CONFIG_PACKAGE_ltq-vdsl-vr9-vectoring-fw-installer is not set
# CONFIG_PACKAGE_kmod-ltq-ptm-vr9 is not set
# CONFIG_PACKAGE_kmod-ltq-atm-vr9 is not set
